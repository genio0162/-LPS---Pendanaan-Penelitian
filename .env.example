# =====================================================================
#  LPS — Pendanaan Penelitian · contoh berkas environment
#  Salin menjadi .env.local untuk pengembangan lokal.
#  Di Vercel, isi nilai-nilai ini di Settings → Environment Variables.
# =====================================================================

# --- Wajib: kunci Claude API (Anthropic) -----------------------------
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Opsional: model dan kedalaman penalaran -------------------------
# Bawaan claude-sonnet-5 + effort medium. Kombinasi itu terukur menghasilkan
# putusan yang sama dengan claude-opus-5 pada proposal contoh, dengan biaya
# sekitar 2,4x lebih murah. Naikkan hanya bila memang dibutuhkan.
# CLAUDE_MODEL=claude-opus-5
# KAK_EFFORT=high          # low | medium | high | xhigh | max

# --- Wajib: basis data Neon ------------------------------------------
# Terisi OTOMATIS saat integrasi Neon disambungkan di Vercel.
# Untuk lokal, salin connection string dari Neon Console.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# --- Opsional: arsip PDF di Vercel Blob ------------------------------
# Terisi OTOMATIS saat Blob Store disambungkan di Vercel.
# Bila kosong, portal tetap berjalan tanpa mengarsipkan PDF.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxx

# --- Opsional tapi sangat disarankan di produksi ----------------------
# Mengunci Panel Fine-Tuner. Bila kosong, panel terbuka untuk siapa pun.
ADMIN_PASSWORD=ganti-dengan-kata-sandi-panjang-dan-acak
